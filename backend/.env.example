# Environment
ENVIRONMENT=development

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./aurevia.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aurevia

# API
API_V1_PREFIX=/api/v1
PROJECT_NAME=Aurevia API
DEBUG=true

# CORS — add your frontend URL in production
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:5500","null"]

# Secret key for future JWT auth
SECRET_KEY=change-this-to-a-long-random-secret-in-production
